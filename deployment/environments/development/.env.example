POSTGRES_DB=flowstock
POSTGRES_USER=flowstock
POSTGRES_PASSWORD=replace-with-random-development-value
FLOWSTOCK_DATABASE_URL=postgresql+psycopg://flowstock:replace-with-random-development-value@postgres:5432/flowstock
FLOWSTOCK_ENVIRONMENT=development
FLOWSTOCK_EDGE_PORT=8080
FLOWSTOCK_LOG_LEVEL=DEBUG
FLOWSTOCK_OTEL_ENABLED=false
FLOWSTOCK_SESSION_IDLE_MINUTES=15
FLOWSTOCK_SESSION_ABSOLUTE_HOURS=12
FLOWSTOCK_SESSION_COOKIE_SECURE=false
FLOWSTOCK_SECRET_HASH_KEY=replace-with-at-least-32-random-development-characters
FLOWSTOCK_DATA_ENCRYPTION_KEY=replace-with-independent-development-encryption-key
GRAFANA_ADMIN_PASSWORD=replace-with-random-development-value
GRAFANA_PORT=3000
