POSTGRES_DB=flowstock_acceptance
POSTGRES_USER=flowstock_acceptance
POSTGRES_PASSWORD=replace-with-random-acceptance-secret
FLOWSTOCK_DATABASE_URL=postgresql+psycopg://flowstock_acceptance:replace-with-random-acceptance-secret@postgres:5432/flowstock_acceptance
FLOWSTOCK_ENVIRONMENT=acceptance
FLOWSTOCK_EDGE_PORT=8081
FLOWSTOCK_LOG_LEVEL=INFO
FLOWSTOCK_OTEL_ENABLED=false
FLOWSTOCK_SESSION_IDLE_MINUTES=15
FLOWSTOCK_SESSION_ABSOLUTE_HOURS=12
FLOWSTOCK_SESSION_COOKIE_SECURE=false
FLOWSTOCK_SECRET_HASH_KEY=replace-with-at-least-32-random-acceptance-characters
FLOWSTOCK_DATA_ENCRYPTION_KEY=replace-with-independent-acceptance-encryption-key
GRAFANA_ADMIN_PASSWORD=replace-with-random-acceptance-secret
GRAFANA_PORT=3001
