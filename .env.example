# Copy to .env for local Development only. Replace every placeholder.
POSTGRES_DB=flowstock
POSTGRES_USER=flowstock
POSTGRES_PASSWORD=replace-with-a-random-local-password
FLOWSTOCK_DATABASE_URL=postgresql+psycopg://flowstock:replace-with-a-random-local-password@postgres:5432/flowstock
FLOWSTOCK_LOG_LEVEL=INFO
FLOWSTOCK_OTEL_ENABLED=false
FLOWSTOCK_SESSION_IDLE_MINUTES=15
FLOWSTOCK_SESSION_ABSOLUTE_HOURS=12
FLOWSTOCK_SESSION_COOKIE_SECURE=false
FLOWSTOCK_SECRET_HASH_KEY=replace-with-at-least-32-random-characters
FLOWSTOCK_DATA_ENCRYPTION_KEY=replace-with-an-independent-32-character-random-key
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-local-password
